# Core application settings (development only)
APP_NAME=echo-voice
APP_ENV=development
DEBUG=false

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=Echo Voice
CORS_ORIGINS=http://localhost:3000

# Database - use local-only development credentials; never reuse in production
POSTGRES_DB=echo_voice
POSTGRES_USER=echo_dev
POSTGRES_PASSWORD=replace-with-a-local-dev-password
DATABASE_URL=postgresql+psycopg://echo_dev:replace-with-a-local-dev-password@localhost:5432/echo_voice

# Cache
REDIS_URL=redis://localhost:6379/0

# Security - generate a strong random value for local use and a managed secret for production
SECRET_KEY=replace-with-a-long-random-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage - placeholders, integration is not enabled yet
S3_BUCKET=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1

# AI - candidates require license and quality evaluation before enabling
MODEL_PROVIDER=unset
MODEL_DEFAULT=unset
GPU_ENABLED=false

# Admin - these values are not used to bootstrap a production admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Play Billing / AdMob placeholders (not configured)
PLAY_BILLING_PUBLIC_KEY=
ADMOB_APP_ID=

# External API placeholders
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
