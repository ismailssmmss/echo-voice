# Core application settings (development only)
APP_NAME=echo-voice
APP_ENV=development
DEBUG=false

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=Echo Voice
CORS_ORIGINS=http://localhost:3000

# Database - local-only development credentials; never reuse in production
POSTGRES_DB=echo_voice
POSTGRES_USER=echo_dev
POSTGRES_PASSWORD=replace-with-a-local-dev-password
DATABASE_URL=postgresql+psycopg://echo_dev:replace-with-a-local-dev-password@localhost:5432/echo_voice

# Cache / task queue
REDIS_URL=redis://localhost:6379/0

# Security - generate a strong random value for local use and use a secret manager in production
SECRET_KEY=replace-with-a-long-random-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal voice-worker authentication; development value only, replace for any shared environment
WORKER_URL=http://ai-worker:8001
WORKER_API_TOKEN=local-only-worker-token-change-before-production-2026
WORKER_TIMEOUT_SECONDS=1800

# Voice model: SILMA TTS v1 (Arabic and English voice cloning)
MODEL_PROVIDER=silma-tts
MODEL_DEFAULT=silma-tts-v1
MODEL_CACHE_DIR=/models/huggingface
HF_HOME=/models/huggingface
GPU_ENABLED=false

# Admin - these values do not bootstrap a production admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Play Billing / AdMob placeholders (not configured)
PLAY_BILLING_PUBLIC_KEY=
ADMOB_APP_ID=

# External API placeholders
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
