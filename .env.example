# Core application settings
APP_NAME=echo-voice
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=Echo Voice

# Database
POSTGRES_DB=echo_voice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/echo_voice

# Cache
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
S3_BUCKET=echo-voice-dev
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1

# AI
MODEL_PROVIDER=openvoice
MODEL_DEFAULT=openvoice-v2
GPU_ENABLED=true

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Google Play Billing / AdMob placeholders
PLAY_BILLING_PUBLIC_KEY=replace-me
ADMOB_APP_ID=ca-app-pub-0000000000000000

# External API placeholders
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
